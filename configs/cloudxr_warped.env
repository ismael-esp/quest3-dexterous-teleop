# CloudXR runtime overrides -- FALLBACK for the black-headset / "XRComposition (warped) input
# resource is null" failure. Pass with:
#     scripts/cloudxr_service.sh --cloudxr-env-config configs/cloudxr_warped.env
# and launch the Isaac side with --foveation warped so both halves agree.
#
# Background: Kit's AR profile defaults to foveation.mode="warped" and runs an Unwarp/resample
# stage, but the runtime defaults to submitting UNWARPED frames (NV_CXR_APP_PQW_SUBMIT_MODE) with
# PQW_WARPED_WIDTH=0, so the warped source image is never produced and the HMD stays black while
# tracking keeps working. Preferred fix is the other direction (--foveation none, no runtime
# restart needed); use this file only if that does not work.
NV_CXR_APP_PQW_SUBMIT_MODE=warped
